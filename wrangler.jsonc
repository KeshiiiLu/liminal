{
  "name": "liminal-private",
  "compatibility_date": "2026-09-05",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "secrets": {
    "required": [
      "LIMINAL_ACCESS_PASSWORD",
      "LIMINAL_SESSION_SECRET"
    ]
  }
}
